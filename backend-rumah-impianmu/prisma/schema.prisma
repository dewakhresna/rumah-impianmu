generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model House {
  id          Int     @id @default(autoincrement())
  nama        String? @db.VarChar(100)
  c1_harga    Float?  @db.Float
  c2_jarak    Float?  @db.Float
  c3_keamanan Int?
  c4_luas     Float?  @db.Float

  @@map("houses")
}
