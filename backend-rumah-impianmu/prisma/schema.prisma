// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model House {
  id          Int    @id @default(autoincrement())
  nama        String
  c1_harga    Float
  c2_jarak    Float
  c3_keamanan Int
  c4_luas     Float

  @@map("houses")
}
